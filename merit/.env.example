# Copy to .env and fill in real values. Never commit .env.
# SESSION_SECRET / QR_HMAC_SECRET / PRINT_GATEWAY_KEY (each >= 32 chars) have NO defaults: generate them with
# `openssl rand -base64 48`. The app refuses to start when they are missing or shorter than 32 characters.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/merit
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/merit_test
SESSION_SECRET=
QR_HMAC_SECRET=
# Optional: key for secrets stored encrypted in the database (SMTP password). >= 32 chars; falls back to SESSION_SECRET.
# SETTINGS_SECRET_KEY=
PRINT_GATEWAY_KEY=
# Public address written into every QR code. Production: https://qrmenu.merithotels.com
APP_BASE_URL=http://localhost:3000
# DeepL API key (Primary translation provider); free API keys end in :fx.
# DEEPL_AUTH_KEY=
# Google AI Studio API key (Secondary / Failover translation provider).
# Used automatically if DeepL fails or DEEPL_AUTH_KEY is not set.
# GEMINI_API_KEY=
# Optional: where uploaded menu images are stored (default: <cwd>/uploads). Use a persistent,
# application-writable directory in production; it is served through /uploads/[...path].
# UPLOADS_DIR=
# QR URLs are configured after deployment in Denetim Masası → Sistem → `qr.baseUrl`, not here.
# The print gateway's separate environment lives in tools/print-gateway/.env.example.
# Optional: number of trusted reverse proxies in front of the app (default 1 = nginx only). The client IP
# is the Nth x-forwarded-for entry counted from the right; raise it when e.g. a CDN sits before nginx.
# TRUSTED_PROXY_HOPS=1
# Production only: set to false when the site is served over plain HTTP (test environment, IP/sslip.io).
# Default: the session cookie is `secure` in production.
# COOKIE_SECURE=false
# SMTP (optional; without it e-mails are only logged).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# Docker entrypoint: RUN_SEED=true runs prisma/seed.ts once (reference data + admin if missing).
# SEED_DEMO=true additionally loads demo outlets, menus and staff (never on a production database).
# RUN_SEED=true also requires SEED_ADMIN_PASSWORD (min. 10 characters); otherwise the app refuses to start.
# RUN_SEED=false
# SEED_DEMO=false
# REQUIRED by `npm run db:seed`: min. 10 characters, no default. Set your own value.
SEED_ADMIN_PASSWORD=
TZ=Europe/Nicosia

# Eğitim örneği: ENV_LABEL doluysa kabuk durum çubuğunda, personel oturum şeridinde ve misafir sayfası altında
# bu etiket rozet olarak görünür (en çok 20 karakter). Üretimde BOŞ bırakın.
# ENV_LABEL=EĞİTİM
# REQUIRED by `npm run db:seed:demo` (yalnız *_egitim / *_demo / *_test veritabanlarına): min. 10 karakter, varsayılanı yok.
# DEMO_PASSWORD=

# Set to 1 to skip starting pg-boss jobs (tests/CI/build); leave unset for dev and production.
# MERIT_DISABLE_JOBS=1

# Eski minibar (Flask) veritabanı — yalnız göç scripti için (npm run migrate:legacy -- --dry-run). Gerçek değer commit edilmez.
# LEGACY_DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/minibar
# Eski tabloların bulunduğu şema (varsayılan public).
# LEGACY_SCHEMA=public

# Optional Web Push: configure both keys together; omit both to disable push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:it@example.com
# Push abonelik adresi izinli ana makineler (virgülle); boşsa FCM, Mozilla, Apple, Windows servisleri.
# PUSH_ENDPOINT_ALLOWLIST=
# MyBar text translation uses the DeepL / Gemini keys saved in Denetim Masası → Sistem → Çeviri.
# gtx adds Google's keyless endpoint as the last fallback (or the only provider when no key is saved).
TRANSLATE_PROVIDER=none
