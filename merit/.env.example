# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/merit
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/merit_test
SESSION_SECRET=change-me-min-32-chars-random-string
QR_HMAC_SECRET=change-me-min-32-chars-random-string
PRINT_GATEWAY_KEY=change-me-print-gateway-key
APP_BASE_URL=http://localhost:3000
# REQUIRED by `npm run db:seed`: min. 10 characters, no default. Set your own value.
SEED_ADMIN_PASSWORD=
TZ=Europe/Nicosia
