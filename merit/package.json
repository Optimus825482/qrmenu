{
  "name": "merit",
  "version": "2.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:kabul": "playwright test --grep @kabul",
    "test:e2e:matrix": "playwright test --project=desktop-1366x768 --project=tablet-1280x800 --project=tablet-1024x768 --project=tablet-768x1024 --project=tablet-800x1280 --project=phone-390x844",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:merit-menus": "tsx prisma/seed/meritMenus.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:reset": "prisma migrate reset --force",
    "migrate:legacy": "tsx scripts/migrate-from-minibarlatest/index.ts",
    "load:smoke": "tsx tools/load/src/run.ts --smoke",
    "load:full": "tsx tools/load/src/run.ts --guests 300 --staff 40 --radar 5 --minutes 10 --ramp 60",
    "db:seed:load": "tsx prisma/seed-load.ts",
    "kilavuz:resim": "playwright test --config=playwright.guide.config.ts --project=kilavuz"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/pdfkit": "0.17.7",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "html5-qrcode": "2.3.8",
    "iron-session": "^9.0.1",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-device-frameset": "^1.3.4",
    "react-dom": "19.3.0",
    "react-frame-component": "^5.3.2",
    "react-photo-editor": "^3.0.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "3.5.13",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "mailparser": "3.14.2",
    "prisma": "^7.10.0",
    "smtp-server": "3.21.3",
    "tailwindcss": "^4",
