# Merit OS Print Gateway ortam değişkenleri (bu dosyayı .env olarak kopyalayın)
# Değerler merit sunucusundaki ortamla eşleşmelidir.

# Merit sunucusunun kök adresi (sonunda / yok)
API_URL=http://localhost:3000

# Sunucu tarafındaki PRINT_GATEWAY_KEY ile BİREBİR aynı olmalı.
GATEWAY_KEY=degistir-beni

# Basılacak otelin kodu: ROYAL, DIAMOND veya PREMIUM
HOTEL_CODE=ROYAL

# Kuyruk yoklama aralığı (milisaniye)
POLL_MS=2000

# ESC/POS kod sayfası tablo seçimi (ESC t <n>).
# cp857 için 13 — sahada yazıcıyla doğrulanacak; farklı yazıcılarda değiştirilebilir.
CODEPAGE_TABLE=13
