// Merit platform data model — design spec §3.1, §3.2, §3.3.
// Models are English, tables are snake_case plurals via @@map, enum values follow the Turkish business language.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum ModuleKey {
  CORE
  MINIBAR
  QR_MENU
  QR_ORDER
  ROOM_SERVICE
}

enum OutletType {
  HAVUZ
  BAR
  SAHIL
  SALON
  BAHCE
  SPA
  CABANA
  ODA_SERVISI
  GENEL
}

enum PriceDisplay {
  INHERIT
  SHOW
  HIDE
}

enum OutletArea {
  ACIK
  KAPALI
}

enum RoleKind {
  SISTEM
  YONETIM
  OUTLET
  MUTFAK
  MINIBAR
}

enum SessionStatus {
  ONLINE
  UYARI
  CIKTI
  DUSURULDU
}

enum LogoutReason {
  MANUEL
  SURE_ASIMI
  HAREKETSIZLIK
  ZORUNLU
  TEK_CIHAZ
  SISTEM
}

enum ScanKind {
  MISAFIR
  PERSONEL
  SISTEM
}

enum StockMovementType {
  GIRIS
  IADE
  KULLANIM
  MYBAR
  DUZELTME
  GOC
}

enum MinibarTxType {
  SETUP_KONTROL
  SARFIYAT_YOK
  MYBAR_KARSILAMA
  LEGACY
}

enum RoomCheckType {
  URUN_EKLENDI
  SARFIYAT_YOK
  DND
  ACIK
}

enum DndStatus {
  AKTIF
  TAMAMLANDI
  IPTAL
  EKSIK
}

enum MybarStatus {
  BEKLEMEDE
  TAMAMLANDI
  IPTAL
}

enum GuestRecordKind {
  IN_HOUSE
  ARRIVAL
  DEPARTURE
}

enum UploadStatus {
  YUKLENDI
  ISLENIYOR
  TAMAMLANDI
  HATA
  SILINDI
  BEKLIYOR
}

enum TaskType {
  INHOUSE_KONTROL
  ARRIVAL_KONTROL
  DEPARTURE_KONTROL
}

enum CorrectionRequestStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
}

enum CorrectionActionType {
  SILME
  DUZELTME
}

enum TaskStatus {
  BEKLIYOR
  DEVAM
  TAMAMLANDI
  DND_BEKLIYOR
  EKSIK
}

enum StockRequestStatus {
  BEKLEMEDE
  ONAYLANDI
  TESLIM_EDILDI
  REDDEDILDI
  IPTAL
}

enum Urgency {
  NORMAL
  ACIL
}

enum EmailStatus {
  GONDERILDI
  HATA
  BEKLEMEDE
  IPTAL
}

enum MenuNodeKind {
  KATEGORI
  ALT_KATEGORI
  GRUP
  OGE
}

enum OrderKind {
  MASA
  ODA_SERVISI
}

enum OrderStatus {
  GONDERILDI
  TEYIT_BEKLIYOR
  ONAYLANDI
  HAZIR
  YOLDA
  SERVIS_EDILDI
  TESLIM_EDILDI
  REDDEDILDI
  IPTAL
}

enum CallType {
  GARSON
  HESAP
  DIGER
}

enum CallStatus {
  ACIK
  YANITLANDI
  KAPANDI
}

enum PrintJobKind {
  FIS
  MUTFAK
  TEST
}

enum PrintJobStatus {
  KUYRUKTA
  BASILIYOR
  BASILDI
  HATA
}

// ───────────────────────────── §3.1 Core ─────────────────────────────

model Hotel {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  logoUrl            String?  @map("logo_url")
  address            String?
  phone              String?
  isSystemDefault    Boolean  @default(false) @map("is_system_default")
  isActive           Boolean  @default(true) @map("is_active")
  emailNotifyEnabled Boolean  @default(false) @map("email_notify_enabled")
  emailAlertEnabled  Boolean  @default(false) @map("email_alert_enabled")
  emailReportEnabled Boolean  @default(false) @map("email_report_enabled")
  emailSystemEnabled Boolean  @default(false) @map("email_system_enabled")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  modules                   HotelModule[]
  floors                    Floor[]
  roomTypes                 RoomType[]
  rooms                     Room[]
  outlets                   Outlet[]
  users                     User[]
  userHotels                UserHotel[]
  roleScreenPerms           RoleScreenPermission[]
  roleModuleAccesses        RoleModuleAccess[]
  sessions                  UserSession[]
  settings                  Setting[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  emailLogs                 EmailLog[]
  roomTypeSetups            RoomTypeSetup[]
  stocks                    HotelStock[]
  stockMovements            HotelStockMovement[]
  minibarTransactions       MinibarTransaction[]
  roomDnds                  RoomDnd[]
  mybarRequests             MybarRequest[]
  guestRecords              GuestRecord[]
  occupancyUploads          OccupancyUpload[]
  uploadTasks               UploadTask[]
  dailyTasks                DailyTask[]
  stockRequests             StockRequest[]
  minibarCorrectionRequests MinibarCorrectionRequest[]
  orders                    Order[]
  orderCounters             OrderCounter[]
  printers                  Printer[]
  printJobs                 PrintJob[]

  @@map("hotels")
}

model HotelModule {
  id        String    @id @default(cuid())
  hotelId   String    @map("hotel_id")
  moduleKey ModuleKey @map("module_key")
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, moduleKey])
  @@map("hotel_modules")
}

model Floor {
  id        String   @id @default(cuid())
  hotelId   String   @map("hotel_id")
  number    Int
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel Hotel  @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  rooms Room[]

  @@unique([hotelId, number])
  @@map("floors")
}

model RoomType {
  id           String   @id @default(cuid())
  hotelId      String   @map("hotel_id")
  name         String
  cabinetCount Int      @default(0) @map("cabinet_count")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel  Hotel           @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  rooms  Room[]
  setups RoomTypeSetup[]

  @@unique([hotelId, name])
  @@map("room_types")
}

model Room {
  id            String    @id @default(cuid())
  hotelId       String    @map("hotel_id")
  floorId       String    @map("floor_id")
  roomTypeId    String?   @map("room_type_id")
  number        String
  capacity      Int?
  qrToken       String?   @unique @map("qr_token")
  qrGeneratedAt DateTime? @map("qr_generated_at") @db.Timestamptz(3)
  guestMessage  String?   @map("guest_message") @db.VarChar(500)
  extension     String?   @db.VarChar(20)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel               Hotel                @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  floor               Floor                @relation(fields: [floorId], references: [id], onDelete: Restrict)
  roomType            RoomType?            @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  qrScanLogs          QrScanLog[]
  minibarTransactions MinibarTransaction[]
  roomChecks          RoomCheck[]
  roomDnds            RoomDnd[]
  mybarRequests       MybarRequest[]
  guestRecords        GuestRecord[]
  dailyTaskItems      DailyTaskItem[]
  orders              Order[]

  @@unique([hotelId, number])
  @@map("rooms")
}

model Outlet {
  id                   String       @id @default(cuid())
  hotelId              String       @map("hotel_id")
  name                 String
  type                    OutletType
  hasMenu                 Boolean      @default(true) @map("has_menu")
  hasOrdering             Boolean      @default(false) @map("has_ordering")
  orderingEnabled         Boolean      @default(false) @map("ordering_enabled")
  priceDisplay            PriceDisplay @default(INHERIT) @map("price_display")
  themeId                 String?      @map("theme_id")
  printerId               String?      @map("printer_id")
  kdsEnabled              Boolean      @default(false) @map("kds_enabled")
  phoneConfirmRequired    Boolean      @default(false) @map("phone_confirm_required")
  autoPrintReceipt        Boolean      @default(true) @map("auto_print_receipt")
  autoPrintKitchen        Boolean      @default(false) @map("auto_print_kitchen")
  waiterAssignmentEnabled Boolean      @default(false) @map("waiter_assignment_enabled")
  isActive                Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel          Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  theme          MenuTheme?             @relation(fields: [themeId], references: [id], onDelete: SetNull)
  defaultPrinter Printer?               @relation("OutletDefaultPrinter", fields: [printerId], references: [id], onDelete: SetNull)
  ownedPrinters  Printer[]              @relation("PrinterOutlet")
  tables         OutletTable[]
  areas          OutletAreaDefinition[]
  menuDesign     OutletMenuDesign?
  members        OutletMember[]
  assignments    TableAssignment[]
  sessions       UserSession[]
  menuNodes      MenuNode[]
  orders         Order[]
  waiterCalls    WaiterCall[]
  callOptions    OutletCallOption[]

  @@unique([hotelId, name])
  @@map("outlets")
}

model OutletTable {
  id        String   @id @default(cuid())
  outletId  String   @map("outlet_id")
  number    Int?
  name      String?  @db.VarChar(80)
  capacity  Int?
  areaId    String   @map("area_id")
  label     String
  qrToken   String?  @unique @map("qr_token")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet      Outlet               @relation(fields: [outletId], references: [id], onDelete: Restrict)
  area        OutletAreaDefinition @relation(fields: [areaId], references: [id], onDelete: Restrict)
  assignments TableAssignment[]
  qrScanLogs  QrScanLog[]
  orders      Order[]
  waiterCalls WaiterCall[]

  @@unique([outletId, label])
  @@unique([outletId, number])
  @@index([areaId])
  @@map("outlet_tables")
}

model OutletAreaDefinition {
  id              String        @id @default(cuid())
  outletId        String        @map("outlet_id")
  type            OutletArea
  name            String?       @db.VarChar(60)
  orderingEnabled Boolean?      @map("ordering_enabled")
  priceDisplay    PriceDisplay? @map("price_display")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  outlet Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tables OutletTable[]

  @@unique([outletId, type, name])
  @@index([outletId])
  @@map("outlet_areas")
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  jobTitle           String?   @map("job_title")
  email              String?
  /** Rapor/uyarı e-postası almayı kabul etti; varsayılan kapalı, yalnız kullanıcı formundan açılır. */
  emailOptIn         Boolean   @default(false) @map("email_opt_in")
  phone              String?
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  roleId             String    @map("role_id")
  hotelId            String?   @map("hotel_id")
  supervisorId       String?   @map("supervisor_id")
  isActive           Boolean   @default(true) @map("is_active")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  prefs              Json?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  role                       Role                       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  hotel                      Hotel?                     @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  supervisor                 User?                      @relation("UserSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisees                User[]                     @relation("UserSupervisor")
  userHotels                 UserHotel[]
  outletMemberships          OutletMember[]
  tableAssignments           TableAssignment[]
  sessions                   UserSession[]
  notifications              Notification[]
  pushSubscriptions          PushSubscription[]
  auditLogs                  AuditLog[]
  qrScanLogs                 QrScanLog[]
  stockMovements             HotelStockMovement[]
  minibarTransactions        MinibarTransaction[]
  roomChecks                 RoomCheck[]
  roomDndChecks              RoomDndCheck[]
  mybarSeen                  MybarRequest[]             @relation("MybarSeenBy")
  mybarCompleted             MybarRequest[]             @relation("MybarCompletedBy")
  mybarCancelled             MybarRequest[]             @relation("MybarCancelledBy")
  occupancyUploads           OccupancyUpload[]
  taskStatusLogs             TaskStatusLog[]
  stockRequestsMade          StockRequest[]             @relation("StockRequestRequestedBy")
  stockRequestsHandled       StockRequest[]             @relation("StockRequestHandledBy")
  emailLogs                  EmailLog[]
  ordersApproved             Order[]                    @relation("OrderApprovedBy")
  ordersPhoneConfirmed       Order[]                    @relation("OrderPhoneConfirmedBy")
  ordersAssigned             Order[]                    @relation("OrderAssignedWaiter")
  ordersServed               Order[]                    @relation("OrderServedBy")
  ordersDelivered            Order[]                    @relation("OrderDeliveredBy")
  orderEvents                OrderEvent[]
  waiterCallsResolved        WaiterCall[]
  correctionRequestsMade     MinibarCorrectionRequest[] @relation("MinibarCorrectionRequester")
  correctionRequestsApproved MinibarCorrectionRequest[] @relation("MinibarCorrectionApprover")

  @@map("users")
}

model UserHotel {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  hotelId   String   @map("hotel_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@map("user_hotels")
}

model OutletMember {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  outletId  String   @map("outlet_id")
  roleId    String?  @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, outletId])
  @@map("outlet_members")
}

// Partial unique index (at most one active assignment per table) lives in the migration SQL.
model TableAssignment {
  id        String   @id @default(cuid())
  outletId  String   @map("outlet_id")
  tableId   String   @map("table_id")
  userId    String   @map("user_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet Outlet      @relation(fields: [outletId], references: [id], onDelete: Restrict)
  table  OutletTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("table_assignments")
}

model Role {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  kind             RoleKind
  maxOnlineMinutes Int?     @map("max_online_minutes")
  defaultScreen    String?  @map("default_screen")
  isSystem         Boolean  @default(false) @map("is_system")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users             User[]
  outletMembers     OutletMember[]
  screenPermissions RoleScreenPermission[]
  moduleAccesses    RoleModuleAccess[]
  sessions          UserSession[]

  @@map("roles")
}

model AppScreen {
  id        String    @id @default(cuid())
  code      String    @unique
  moduleKey ModuleKey @map("module_key")
  name      String
  path      String
  group     String
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RoleScreenPermission[]

  @@map("app_screens")
}

model RoleScreenPermission {
  id         String   @id @default(cuid())
  roleId     String   @map("role_id")
  screenId   String   @map("screen_id")
  hotelId    String?  @map("hotel_id")
  canView    Boolean  @default(false) @map("can_view")
  canCreate  Boolean  @default(false) @map("can_create")
  canEdit    Boolean  @default(false) @map("can_edit")
  canApprove Boolean  @default(false) @map("can_approve")
  canReport  Boolean  @default(false) @map("can_report")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  role   Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  screen AppScreen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  hotel  Hotel?    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([roleId, screenId, hotelId])
  @@map("role_screen_permissions")
}

model RoleModuleAccess {
  id        String    @id @default(cuid())
  roleId    String    @map("role_id")
  hotelId   String?   @map("hotel_id")
  moduleKey ModuleKey @map("module_key")
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  role  Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([roleId, hotelId, moduleKey])
  @@map("role_module_accesses")
}

model UserSession {
  id           String        @id @default(cuid())
  userId       String        @map("user_id")
  hotelId      String        @map("hotel_id")
  outletId     String?       @map("outlet_id")
  roleId       String        @map("role_id")
  deviceLabel  String?       @map("device_label")
  status       SessionStatus @default(ONLINE)
  loginAt      DateTime      @default(now()) @map("login_at") @db.Timestamptz(3)
  lastSeenAt   DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(3)
  warnedAt     DateTime?     @map("warned_at") @db.Timestamptz(3)
  logoutAt     DateTime?     @map("logout_at") @db.Timestamptz(3)
  logoutReason LogoutReason? @map("logout_reason")
  ip           String
  userAgent    String        @map("user_agent")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  hotel  Hotel          @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  outlet Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)
  role   Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  events SessionEvent[]

  @@index([status, expiresAt])
  @@map("user_sessions")
}

model SessionEvent {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  event     String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("session_events")
}

model Setting {
  id        String   @id @default(cuid())
  hotelId   String?  @map("hotel_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, key])
  @@map("settings")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  hotelId   String?   @map("hotel_id")
  type      String
  title     String
  body      String
  refType   String?   @map("ref_type")
  refId     String?   @map("ref_id")
  isRead    Boolean   @default(false) @map("is_read")
  pushedAt  DateTime? @map("pushed_at") @db.Timestamptz(3)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([type, refId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  failCount  Int      @default(0) @map("fail_count")
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?  @map("user_agent")
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  hotelId   String?  @map("hotel_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model QrScanLog {
  id        String   @id @default(cuid())
  roomId    String?  @map("room_id")
  tableId   String?  @map("table_id")
  userId    String?  @map("user_id")
  kind      ScanKind
  ok        Boolean
  error     String?
  ip        String
  userAgent String   @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room  Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  table OutletTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("qr_scan_logs")
}

// ───────────────────────────── §3.2 Minibar ─────────────────────────────

model ProductGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("product_groups")
}

model Product {
  id            String   @id @default(cuid())
  groupId       String   @map("group_id")
  code          String?  @unique
  name          String
  barcode       String?  @unique
  unit          String   @default("Adet")
  criticalLevel Int      @default(10) @map("critical_level")
  purchasePrice Decimal? @map("purchase_price") @db.Decimal(10, 2)
  salePrice     Decimal? @map("sale_price") @db.Decimal(10, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  group             ProductGroup             @relation(fields: [groupId], references: [id], onDelete: Restrict)
  setupItems        SetupItem[]
  stocks            HotelStock[]
  stockMovements    HotelStockMovement[]
  transactionItems  MinibarTransactionItem[]
  mybarRequestItems MybarRequestItem[]
  stockRequestItems StockRequestItem[]

  @@map("products")
}

model Setup {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?
  isInsideCabinet Boolean  @default(true) @map("is_inside_cabinet")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items            SetupItem[]
  roomTypeSetups   RoomTypeSetup[]
  transactionItems MinibarTransactionItem[]

  @@map("setups")
}

model SetupItem {
  id        String   @id @default(cuid())
  setupId   String   @map("setup_id")
  productId String   @map("product_id")
  qty       Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  setup   Setup   @relation(fields: [setupId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([setupId, productId])
  @@map("setup_items")
}

model RoomTypeSetup {
  hotelId    String   @map("hotel_id")
  roomTypeId String   @map("room_type_id")
  setupId    String   @map("setup_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  setup    Setup    @relation(fields: [setupId], references: [id], onDelete: Restrict)

  @@id([hotelId, roomTypeId, setupId])
  @@map("room_type_setups")
}

// CHECKs (remaining/used/total/critical >= 0, total - used = remaining) live in the migration SQL.
model HotelStock {
  id            String   @id @default(cuid())
  hotelId       String   @map("hotel_id")
  productId     String   @map("product_id")
  totalQty      Int      @default(0) @map("total_qty")
  usedQty       Int      @default(0) @map("used_qty")
  remainingQty  Int      @default(0) @map("remaining_qty")
  criticalLevel Int      @default(50) @map("critical_level")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([hotelId, productId])
  @@map("hotel_stocks")
}

model HotelStockMovement {
  id        String            @id @default(cuid())
  hotelId   String            @map("hotel_id")
  productId String            @map("product_id")
  userId    String            @map("user_id")
  type      StockMovementType
  qty       Int
  refType   String?           @map("ref_type")
  refId     String?           @map("ref_id")
  note      String?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([hotelId, productId, createdAt])
  @@index([hotelId, createdAt])
  @@map("hotel_stock_movements")
}

model MinibarTransaction {
  id              String        @id @default(cuid())
  hotelId         String        @map("hotel_id")
  roomId          String        @map("room_id")
  userId          String        @map("user_id")
  type            MinibarTxType
  mybarRequestId  String?       @map("mybar_request_id")
  legacyType      String?       @map("legacy_type")
  note            String?
  clientRequestId String?       @unique @map("client_request_id")
  occurredAt      DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  hotel              Hotel                      @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room               Room                       @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user               User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items              MinibarTransactionItem[]
  roomChecks         RoomCheck[]
  mybarRequest       MybarRequest?              @relation(fields: [mybarRequestId], references: [id], onDelete: SetNull)
  correctionRequests MinibarCorrectionRequest[]

  @@index([roomId, occurredAt])
  @@index([hotelId, occurredAt])
  @@index([userId, occurredAt])
  @@index([mybarRequestId])
  @@map("minibar_transactions")
}

model MinibarTransactionItem {
  id              String   @id @default(cuid())
  transactionId   String   @map("transaction_id")
  productId       String   @map("product_id")
  setupId         String?  @map("setup_id")
  setupQty        Int      @default(0) @map("setup_qty")
  startStock      Int      @default(0) @map("start_stock")
  endStock        Int      @default(0) @map("end_stock")
  consumed        Int      @default(0)
  added           Int      @default(0)
  purchasePrice   Decimal? @map("purchase_price") @db.Decimal(10, 2)
  salePrice       Decimal? @map("sale_price") @db.Decimal(10, 2)
  legacyExtra     Int?     @map("legacy_extra")
  isComplimentary Boolean  @default(false) @map("is_complimentary")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction MinibarTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  setup       Setup?             @relation(fields: [setupId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@map("minibar_transaction_items")
}

model MinibarCorrectionRequest {
  id            String                  @id @default(cuid())
  hotelId       String                  @map("hotel_id")
  transactionId String?                 @map("transaction_id")
  requestedById String                  @map("requested_by_id")
  approvedById  String?                 @map("approved_by_id")
  actionType    CorrectionActionType    @map("action_type")
  reason        String
  status        CorrectionRequestStatus @default(BEKLIYOR)
  proposedData  Json?                   @map("proposed_data")
  rejectReason  String?                 @map("reject_reason")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt    DateTime?               @map("resolved_at") @db.Timestamptz(3)

  hotel       Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  transaction MinibarTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  requestedBy User                @relation("MinibarCorrectionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?               @relation("MinibarCorrectionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([hotelId, status])
  @@map("minibar_correction_requests")
}

model RoomCheck {
  id            String        @id @default(cuid())
  roomId        String        @map("room_id")
  userId        String        @map("user_id")
  transactionId String?       @map("transaction_id")
  checkDate     DateTime      @map("check_date") @db.Date
  startedAt     DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt       DateTime?     @map("ended_at") @db.Timestamptz(3)
  type          RoomCheckType
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  room        Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction MinibarTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([roomId, checkDate])
  @@index([userId, checkDate])
  @@index([checkDate])
  @@map("room_checks")
}

model RoomDnd {
  id             String    @id @default(cuid())
  hotelId        String    @map("hotel_id")
  roomId         String    @map("room_id")
  date           DateTime  @db.Date
  count          Int       @default(1)
  firstAt        DateTime  @default(now()) @map("first_at") @db.Timestamptz(3)
  lastAt         DateTime  @default(now()) @map("last_at") @db.Timestamptz(3)
  status         DndStatus @default(AKTIF)
  taskItemId     String?   @map("task_item_id")
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel    Hotel          @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room     Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  taskItem DailyTaskItem? @relation(fields: [taskItemId], references: [id], onDelete: SetNull)
  checks   RoomDndCheck[]

  @@unique([roomId, date])
  @@index([status, date])
  @@map("room_dnds")
}

model RoomDndCheck {
  id        String   @id @default(cuid())
  dndId     String   @map("dnd_id")
  no        Int
  userId    String   @map("user_id")
  at        DateTime @default(now()) @db.Timestamptz(3)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  dnd  RoomDnd @relation(fields: [dndId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([at])
  @@map("room_dnd_checks")
}

model MybarRequest {
  id                String      @id @default(cuid())
  hotelId           String      @map("hotel_id")
  roomId            String      @map("room_id")
  businessDate      DateTime    @map("business_date") @db.Date
  status            MybarStatus @default(BEKLEMEDE)
  language          String
  note              String?
  noteTr            String?     @map("note_tr")
  noteSrcLang       String?     @map("note_src_lang") @db.VarChar(8)
  seenById          String?     @map("seen_by_id")
  seenAt            DateTime?   @map("seen_at") @db.Timestamptz(3)
  completedById     String?     @map("completed_by_id")
  completedAt       DateTime?   @map("completed_at") @db.Timestamptz(3)
  closeNote         String?     @map("close_note")
  closedWithMissing Boolean     @default(false) @map("closed_with_missing")
  cancelledById     String?     @map("cancelled_by_id")
  cancelledAt       DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelNote        String?     @map("cancel_note")
  idempotencyKey    String      @unique @map("idempotency_key")
  clientIp          String      @map("client_ip")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel       Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room        Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  seenBy      User?              @relation("MybarSeenBy", fields: [seenById], references: [id], onDelete: SetNull)
  completedBy User?              @relation("MybarCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  cancelledBy User?              @relation("MybarCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items       MybarRequestItem[]
  transactions MinibarTransaction[]

  @@index([hotelId, status])
  @@index([hotelId, businessDate])
  @@index([roomId, businessDate])
  @@map("mybar_requests")
}

model MybarRequestItem {
  id           String   @id @default(cuid())
  requestId    String   @map("request_id")
  productId    String   @map("product_id")
  requestedQty Int      @map("requested_qty")
  deliveredQty Int      @default(0) @map("delivered_qty")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  request MybarRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([requestId, productId])
  @@map("mybar_request_items")
}

model GuestRecord {
  id            String          @id @default(cuid())
  hotelId       String          @map("hotel_id")
  roomId        String          @map("room_id")
  uploadId      String?         @map("upload_id")
  batchCode     String          @map("batch_code")
  guestCount    Int             @map("guest_count")
  arrivalDate   DateTime        @map("arrival_date") @db.Date
  arrivalTime   String?         @map("arrival_time")
  departureDate DateTime        @map("departure_date") @db.Date
  departureTime String?         @map("departure_time")
  kind          GuestRecordKind
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  hotel          Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room           Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  upload         OccupancyUpload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  dailyTaskItems DailyTaskItem[]

  @@index([hotelId, kind, arrivalDate, departureDate])
  @@index([roomId, kind])
  @@map("guest_records")
}

model OccupancyUpload {
  id         String       @id @default(cuid())
  hotelId    String       @map("hotel_id")
  code       String       @unique
  fileName   String       @map("file_name")
  kind       String
  status     UploadStatus @default(YUKLENDI)
  totalRows  Int          @default(0) @map("total_rows")
  okRows     Int          @default(0) @map("ok_rows")
  errorRows  Int          @default(0) @map("error_rows")
  errors     Json         @default("[]")
  storedPath String?      @map("stored_path")
  userId     String       @map("user_id")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  guestRecords GuestRecord[]
  uploadTasks  UploadTask[]

  @@map("occupancy_uploads")
}

model UploadTask {
  id        String       @id @default(cuid())
  hotelId   String       @map("hotel_id")
  date      DateTime     @db.Date
  kind      String
  status    UploadStatus @default(YUKLENDI)
  uploadId  String?      @map("upload_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel  Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  upload OccupancyUpload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@unique([hotelId, date, kind])
  @@map("upload_tasks")
}

model DailyTask {
  id          String     @id @default(cuid())
  hotelId     String     @map("hotel_id")
  date        DateTime   @db.Date
  type        TaskType
  status      TaskStatus @default(BEKLIYOR)
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel Hotel           @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  items DailyTaskItem[]

  @@unique([hotelId, date, type])
  @@map("daily_tasks")
}

model DailyTaskItem {
  id            String     @id @default(cuid())
  taskId        String     @map("task_id")
  roomId        String     @map("room_id")
  guestRecordId String?    @map("guest_record_id")
  status        TaskStatus @default(BEKLIYOR)
  arrivalTime   String?    @map("arrival_time")
  departureTime String?    @map("departure_time")
  priority      Int        @default(999)
  checkedAt     DateTime?  @map("checked_at") @db.Timestamptz(3)
  dndCount      Int        @default(0) @map("dnd_count")
  lastDndAt     DateTime?  @map("last_dnd_at") @db.Timestamptz(3)
  note          String?
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  task        DailyTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  room        Room            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  guestRecord GuestRecord?    @relation(fields: [guestRecordId], references: [id], onDelete: SetNull)
  statusLogs  TaskStatusLog[]
  roomDnds    RoomDnd[]

  @@unique([taskId, roomId])
  @@index([taskId])
  @@index([roomId])
  @@map("daily_task_items")
}

model TaskStatusLog {
  id         String      @id @default(cuid())
  taskItemId String      @map("task_item_id")
  from       TaskStatus?
  to         TaskStatus
  userId     String?     @map("user_id")
  note       String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  taskItem DailyTaskItem @relation(fields: [taskItemId], references: [id], onDelete: Cascade)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("task_status_logs")
}

model StockRequest {
  id            String             @id @default(cuid())
  hotelId       String             @map("hotel_id")
  code          String             @unique
  requestedById String             @map("requested_by_id")
  handledById   String?            @map("handled_by_id")
  status        StockRequestStatus @default(BEKLEMEDE)
  note          String?
  rejectReason  String?            @map("reject_reason")
  approvedAt    DateTime?          @map("approved_at") @db.Timestamptz(3)
  deliveredAt   DateTime?          @map("delivered_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel       Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  requestedBy User               @relation("StockRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  handledBy   User?              @relation("StockRequestHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  items       StockRequestItem[]

  @@index([hotelId, status])
  @@map("stock_requests")
}

model StockRequestItem {
  id           String   @id @default(cuid())
  requestId    String   @map("request_id")
  productId    String   @map("product_id")
  requestedQty Int      @map("requested_qty")
  approvedQty  Int?     @map("approved_qty")
  deliveredQty Int?     @map("delivered_qty")
  urgency      Urgency  @default(NORMAL)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  request StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("stock_request_items")
}

// Singleton row (system level).
model EmailSetting {
  id          String   @id @default(cuid())
  smtpHost    String   @map("smtp_host")
  port        Int
  user        String
  passwordEnc String   @map("password_enc")
  tls         Boolean  @default(false)
  ssl         Boolean  @default(false)
  senderEmail String   @map("sender_email")
  senderName  String   @map("sender_name")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("email_settings")
}

model EmailLog {
  id         String      @id @default(cuid())
  to         String
  userId     String?     @map("user_id")
  subject    String
  kind       String
  status     EmailStatus @default(BEKLEMEDE)
  error      String?
  trackingId String      @unique @map("tracking_id")
  refType    String?     @map("ref_type")
  refId      String?     @map("ref_id")
  /** Alıcı başına teslim kaydı (P7): otel, şablon, parametreler, tekrar gönderimi önleyen anahtar. */
  hotelId    String?     @map("hotel_id")
  template   String?
  params     Json?
  dedupeKey  String?     @unique @map("dedupe_key")
  attempts   Int         @default(0)
  sentAt     DateTime?   @map("sent_at") @db.Timestamptz(3)
  messageId  String?     @map("message_id")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@index([hotelId, createdAt])
  @@index([status, createdAt])
  @@map("email_logs")
}

// ───────────────────────────── §3.3 Menu & orders ─────────────────────────────

// Hierarchy rules (items under categories, subcategories, or legacy groups) are enforced in the service layer.
model MenuNode {
  id          String       @id @default(cuid())
  outletId    String       @map("outlet_id")
  parentId    String?      @map("parent_id")
  kind        MenuNodeKind
  name        String
  detail      String?
  imageUrl    String?      @map("image_url")
  imageUrls   String[]     @default([]) @map("image_urls")
  price       Decimal?     @db.Decimal(10, 2)
  currency    String       @default("EUR")
  allergens   String[]     @default([])
  tags        String[]     @default([])
  isAvailable Boolean      @default(true) @map("is_available")
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet       Outlet                @relation(fields: [outletId], references: [id], onDelete: Restrict)
  parent       MenuNode?             @relation("MenuNodeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     MenuNode[]            @relation("MenuNodeTree")
  translations MenuNodeTranslation[]
  orderItems   OrderItem[]

  @@index([outletId, parentId])
  @@index([outletId, kind, isActive])
  @@map("menu_nodes")
}

model MenuNodeTranslation {
  id         String   @id @default(cuid())
  nodeId     String   @map("node_id")
  lang       String
  name       String
  detail     String?
  isVerified Boolean  @default(true) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  node MenuNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, lang])
  @@map("menu_node_translations")
}

model MenuTheme {
  id           String   @id @default(cuid())
  name         String
  bg           String
  accent       String
  soft         String
  textOnAccent String   @map("text_on_accent")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlets Outlet[]

  @@unique([name])
  @@map("menu_themes")
}

model OutletMenuDesign {
  id        String   @id @default(cuid())
  outletId  String   @unique @map("outlet_id")
  ambience  String   @default("RESORT") @db.VarChar(32)
  concept   String   @default("LUXURY") @db.VarChar(32)
  template  String   @default("ROYAL") @db.VarChar(32)
  layout    Json     @default("[\"hero\",\"categories\",\"items\"]")
  options   Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@map("outlet_menu_designs")
}

model Order {
  id                 String      @id @default(cuid())
  hotelId            String      @map("hotel_id")
  outletId           String      @map("outlet_id")
  kind               OrderKind
  tableId            String?     @map("table_id")
  roomId             String?     @map("room_id")
  businessDate       DateTime    @map("business_date") @db.Date
  orderNo            Int         @map("order_no")
  status             OrderStatus @default(GONDERILDI)
  guestLanguage      String      @map("guest_language")
  pricesShown        Boolean     @default(false) @map("prices_shown")
  currency           String      @default("EUR")
  subtotal           Decimal?    @db.Decimal(10, 2)
  note               String?
  approvedById       String?     @map("approved_by_id")
  approvedAt         DateTime?   @map("approved_at") @db.Timestamptz(3)
  rejectReason       String?     @map("reject_reason")
  phoneConfirmedById String?     @map("phone_confirmed_by_id")
  phoneConfirmedAt   DateTime?   @map("phone_confirmed_at") @db.Timestamptz(3)
  readyAt            DateTime?   @map("ready_at") @db.Timestamptz(3)
  servedAt           DateTime?   @map("served_at") @db.Timestamptz(3)
  assignedWaiterId   String?     @map("assigned_waiter_id")
  servedById         String?     @map("served_by_id")
  onWayAt            DateTime?   @map("on_way_at") @db.Timestamptz(3)
  deliveredAt        DateTime?   @map("delivered_at") @db.Timestamptz(3)
  deliveredById      String?     @map("delivered_by_id")
  slaWarnedAt        DateTime?   @map("sla_warned_at") @db.Timestamptz(3)
  slaBreachedAt      DateTime?   @map("sla_breached_at") @db.Timestamptz(3)
  prepStartedAt      DateTime?   @map("prep_started_at") @db.Timestamptz(3)
  rejectedAt         DateTime?   @map("rejected_at") @db.Timestamptz(3)
  escalatedAt        DateTime?   @map("escalated_at") @db.Timestamptz(3)
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  idempotencyKey     String      @unique @map("idempotency_key")
  clientIp           String      @map("client_ip")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel            Hotel        @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  outlet           Outlet       @relation(fields: [outletId], references: [id], onDelete: Restrict)
  table            OutletTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  room             Room?        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  approvedBy       User?        @relation("OrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  phoneConfirmedBy User?        @relation("OrderPhoneConfirmedBy", fields: [phoneConfirmedById], references: [id], onDelete: SetNull)
  assignedWaiter   User?        @relation("OrderAssignedWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  servedBy         User?        @relation("OrderServedBy", fields: [servedById], references: [id], onDelete: SetNull)
  deliveredBy      User?        @relation("OrderDeliveredBy", fields: [deliveredById], references: [id], onDelete: SetNull)
  items            OrderItem[]
  events           OrderEvent[]
  printJobs        PrintJob[]

  @@unique([hotelId, businessDate, orderNo])
  @@index([outletId, status, createdAt])
  @@index([roomId, status])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  menuNodeId   String   @map("menu_node_id")
  nameSnapshot String   @map("name_snapshot")
  qty          Int
  unitPrice    Decimal? @map("unit_price") @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuNode MenuNode @relation(fields: [menuNodeId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String       @map("order_id")
  userId    String?      @map("user_id")
  from      OrderStatus?
  to        OrderStatus
  note      String?
  at        DateTime     @default(now()) @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([at])
  @@map("order_events")
}

// Per-hotel, per-business-day counter that backs Order.orderNo.
model OrderCounter {
  id           String   @id @default(cuid())
  hotelId      String   @map("hotel_id")
  businessDate DateTime @map("business_date") @db.Date
  lastNo       Int      @default(0) @map("last_no")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  @@unique([hotelId, businessDate])
  @@map("order_counters")
}

model WaiterCall {
  id           String     @id @default(cuid())
  outletId     String     @map("outlet_id")
  tableId      String     @map("table_id")
  type         CallType
  note         String?    @db.VarChar(200)
  status       CallStatus @default(ACIK)
  resolvedById String?    @map("resolved_by_id")
  resolvedAt   DateTime?  @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet     Outlet      @relation(fields: [outletId], references: [id], onDelete: Restrict)
  table      OutletTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  resolvedBy User?       @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([outletId, status])
  @@index([tableId, status])
  @@index([outletId, createdAt])
  @@map("waiter_calls")
}

model Printer {
  id         String    @id @default(cuid())
  hotelId    String    @map("hotel_id")
  outletId   String?   @map("outlet_id")
  name       String
  ip         String
  port       Int       @default(9100)
  codepage   String    @default("cp857")
  paperWidth Int       @default(80) @map("paper_width")
  isActive   Boolean   @default(true) @map("is_active")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  lastStatus String?   @map("last_status")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel             Hotel      @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  outlet            Outlet?    @relation("PrinterOutlet", fields: [outletId], references: [id], onDelete: SetNull)
  defaultForOutlets Outlet[]   @relation("OutletDefaultPrinter")
  jobs              PrintJob[]

  @@unique([hotelId, name])
  @@map("printers")
}

model PrintJob {
  id        String         @id @default(cuid())
  hotelId   String         @map("hotel_id")
  printerId String         @map("printer_id")
  orderId   String?        @map("order_id")
  kind      PrintJobKind
  payload   Json
  status    PrintJobStatus @default(KUYRUKTA)
  attempts  Int            @default(0)
  error     String?
  startedAt DateTime?      @map("started_at") @db.Timestamptz(3)
  printedAt DateTime?      @map("printed_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  printer Printer @relation(fields: [printerId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([printerId, status])
  @@index([hotelId, status, createdAt])
  @@map("print_jobs")
}

model OutletCallOption {
  id           String   @id @default(cuid())
  outletId     String   @map("outlet_id")
  label        String   @db.VarChar(60)
  translations Json     @default("{}")
  callType     CallType @map("call_type")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, sortOrder])
  @@map("outlet_call_options")
}

/// Legacy (minibarlatest) id -> new id; makes the one-off migration idempotent.
model LegacyIdMap {
  entity    String   @db.VarChar(40)
  legacyId  String   @map("legacy_id") @db.VarChar(120)
  newId     String   @map("new_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([entity, legacyId])
  @@index([entity, newId])
  @@map("legacy_id_map")
}

/// Raw legacy rows with no counterpart in the new model (e.g. personel zimmet), kept for reference.
model LegacyArchive {
  id          String   @id @default(cuid())
  legacyTable String   @map("legacy_table")
  legacyId    String   @map("legacy_id")
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([legacyTable, legacyId])
  @@map("legacy_personel_zimmet")
}

// Narrow projection of four operational signals that leave no timestamped trace elsewhere
// (printer health, table assignment history, staff idle, missing occupancy upload). Live radar replay only.
model OperationEvent {
  id       String   @id @default(cuid())
  hotelId  String   @map("hotel_id")
  outletId String?  @map("outlet_id")
  type     String // printer.health | table.assigned | presence.idle | upload.missing
  refId    String?  @map("ref_id")
  data     Json     @default("{}")
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@index([hotelId, at])
  @@map("operation_events")
}

model TextTranslation {
  id         String   @id @default(cuid())
  sourceHash String   @map("source_hash") @db.VarChar(64)
  sourceText String   @map("source_text") @db.VarChar(600)
  targetLang String   @map("target_lang") @db.VarChar(8)
  translated String   @db.VarChar(1200)
  provider   String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([sourceHash, targetLang])
  @@map("text_translations")
}
