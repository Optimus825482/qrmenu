# Merit OS — üretim ortam dosyası örneği.  Kopyala: sudo install -m 600 -o merit -g merit deploy/env.production.example /etc/merit/merit.env
# Her CHANGE_ME_ değeri değiştirilmelidir. Gerçek değerleri depoya KOYMAYIN.
# Anahtar üretimi: openssl rand -base64 48

NODE_ENV=production
PORT=3000
TZ=Europe/Nicosia

# --- Zorunlu ---------------------------------------------------------------
# Parolada özel karakter varsa URL'de yüzde-kodlayın.
DATABASE_URL=postgresql://merit:CHANGE_ME_DB_PASSWORD@localhost:5432/merit
# En az 32 karakter, rastgele; birbirinden farklı üç değer.
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
QR_HMAC_SECRET=CHANGE_ME_QR_HMAC_SECRET
# Yazdırma geçidindeki GATEWAY_KEY ile birebir aynı.
PRINT_GATEWAY_KEY=CHANGE_ME_PRINT_GATEWAY_KEY
# Dış adres (HTTPS, sonunda / yok). Kurulumdan ÖNCE kesinleştirin; QR çıktıları adres gömer.
APP_BASE_URL=https://merit.otel.example

# --- İlk kurulum (seed sonrası SİLİN) --------------------------------------
# `npm run db:seed` için zorunlu, en az 10 karakter; admin yoksa bu parolayla oluşturulur.
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_ONCE
# Yalnız eğitim/demo örneği; canlı veritabanında kullanmayın.
# DEMO_PASSWORD=
# Başlık şeridinde görünen ortam etiketi (eğitim örneği için systemd birimi EĞİTİM verir).
# ENV_LABEL=

# --- İsteğe bağlı -----------------------------------------------------------
# DB testleri yalnız geliştirmede; üretimde gerekmez.
# DATABASE_URL_TEST=
# Veritabanı bağlantı havuzu üst sınırı (varsayılan: 20; 5-100 arası).
# DB_POOL_MAX=20
# Veritabanında şifreli saklanan sırların anahtarı (SMTP parolası); >= 32 karakter, yoksa SESSION_SECRET.
# SETTINGS_SECRET_KEY=CHANGE_ME_SETTINGS_SECRET_KEY
# Menü görselleri için kalıcı dizin; merit kullanıcısı yazabilmeli ve yedeğe dahildir.
UPLOADS_DIR=/var/lib/merit/uploads
# Yedek betiği için parolasız URL (parola ~/.pgpass içinde); boşsa DATABASE_URL kullanılır.
# BACKUP_DATABASE_URL=postgresql://merit@localhost:5432/merit
# Menü çevirisi sağlayıcıları (DeepL birincil, Gemini yedek).
# DEEPL_AUTH_KEY=
# GEMINI_API_KEY=
# Önündeki güvenilir vekil sayısı (yalnız nginx = 1).
# TRUSTED_PROXY_HOPS=1
# YALNIZ düz HTTP test ortamı için false; gerçek kurulumda ayarlamayın.
# COOKIE_SECURE=false
# SMTP yedek kaynağı; asıl ayar Sistem ayarları ekranındadır.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# Docker girişi (RUN_SEED / SEED_DEMO); systemd kurulumunda kullanılmaz.
# RUN_SEED=false
# SEED_DEMO=false
# Yalnız test/CI/derleme; üretimde ayarlamayın.
# MERIT_DISABLE_JOBS=1
# Eski Flask minibar verisi göçü için (npm run migrate:legacy); göç bitince kaldırın.
# LEGACY_DATABASE_URL=
# LEGACY_SCHEMA=public
# Web Push: iki anahtar birlikte. Üretim: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:it@example.com
# Push sunucusu izin listesi (virgülle); boşsa FCM, Mozilla, Apple, Windows.
# PUSH_ENDPOINT_ALLOWLIST=
# MyBar metin çevirisi: none (varsayılan) veya gtx.
TRANSLATE_PROVIDER=none
