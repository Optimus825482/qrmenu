# Merit print gateway ortamı: sudo install -m 600 -o merit -g merit deploy/gateway.env.example /etc/merit/gateway.env
API_URL=https://merit.otel.example
# Sunucudaki PRINT_GATEWAY_KEY ile birebir aynı.
GATEWAY_KEY=CHANGE_ME_PRINT_GATEWAY_KEY
# ROYAL, DIAMOND veya PREMIUM
HOTEL_CODE=ROYAL
POLL_MS=2000
# ESC/POS kod sayfası tablosu (cp857 için 13); "Test fişi" ile sahada doğrulayın.
CODEPAGE_TABLE=13
